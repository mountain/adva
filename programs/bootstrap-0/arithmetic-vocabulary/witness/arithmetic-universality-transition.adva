      "candidates": [
        {
          "local_name": "arithmetic-universality",
          "claim": "Mingli Yuan proposes arithmetic universality: finite arithmetic syntax and finite witnessed computation may provide a common constructive presentation for task-relative languages, with additive-zero and multiplicative-unit boundary questions supplied by the opposite hypothesis named hypothesized-arithmetic-truth. The class of languages, translation, preservation relation, and universal property remain to be specified and proved.",
          "addressed_obligations": [
            "experiment:first:m6-time-characteristic-required",
            "experiment:first:m6-space-characteristic-required",
            "experiment:first:m6-construction-characteristic-required",
            "experiment:first:m6-multiplicative-holonomy-required",
            "experiment:first:m6-common-truth-coordinate-required"
          ],
          "assumptions": [
            "A finite observer supplies a task, admissible syntax, typing rules, arithmetic domain, and an explicit resource budget.",
            "A representation must preserve the distinctions required by that task and retain its source, occurrence, ordered-history, and unresolved-obligation correspondence.",
            "The proposed opposition to hypothesized-arithmetic-truth is a research relation, not an established categorical duality.",
            "Finite syntax and decidable checking do not by themselves provide a complete decision method for arbitrary arithmetic truth."
          ],
          "required_observations": [
            "A concrete useful task supplied by Mingli Yuan or Jiamin Zhao, with actual input and an independently checkable acceptance criterion.",
            "An explicit encoder and decoder or task-observation correspondence for a declared class of source languages.",
            "Separate witnesses relating the time, space, and construction readings; an ordered multiplicative witness where the M6 obligation requires one.",
            "A failure or Unknown result when the translation, arithmetic witness, real-world anchor, or budget is missing."
          ],
          "falsifiers": [
            "A claimed supported source expression has no well-typed image within the declared representation class.",
            "The proposed encoding identifies task-distinguishable sources, occurrences, or ordered histories.",
            "The arithmetic check passes while an independently checked task result fails.",
            "A claimed resource advantage disappears when translation, verification, and retained evidence costs are counted."
          ]
        }
      ]
    }
  },
