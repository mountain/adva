      "candidates": [
        {
          "local_name": "hypothesized-arithmetic-truth",
          "claim": "Mingli Yuan proposes hypothesized arithmetic truth as the opposite boundary to arithmetic-universality: an as-yet-unproved additive-zero and multiplicative-unit condition can delimit a constructive arithmetic question. Its occurrence remains a hypothesis until the declared checker supplies an appropriately typed, scoped witness; local discharge does not establish universality or close the open M6 relation.",
          "addressed_obligations": [
            "experiment:first:m6-time-characteristic-required",
            "experiment:first:m6-space-characteristic-required",
            "experiment:first:m6-construction-characteristic-required",
            "experiment:first:m6-multiplicative-holonomy-required",
            "experiment:first:m6-common-truth-coordinate-required"
          ],
          "assumptions": [
            "The arithmetic domain, exact terms, permitted operations, target zero or unit, and witness checker are explicit before the run.",
            "In one illustrative field-valued chart, A-B=0 and A/B=1 are alternative equality readings only where the quotient is defined; at A=B=0 the additive check may pass while the quotient is undefined.",
            "A commutative scalar or polynomial equality cannot discharge an ordered transport or holonomy obligation without an explicit type-correct bridge.",
            "The name truth records the user's proposed boundary and does not upgrade an unproved claim, observation, testimony, or syntax check into an established theorem."
          ],
          "required_observations": [
            "The exact additive residual and multiplicative residual or ordered product, together with all nonzero or invertibility obligations.",
            "A replayable certificate in the chosen fragment, or a retained counterexample or Unknown boundary.",
            "The actual external task input, provenance, and independent output check when the arithmetic boundary is used to help Jiamin Zhao.",
            "A source-to-arithmetic correspondence showing precisely which constructive question is answered and which obligations remain."
          ],
          "falsifiers": [
            "A multiplicative unit is accepted after an undefined division or unauthorized cancellation.",
            "A zero residual under one assignment is presented as a universal identity without its quantifier and domain obligations.",
            "Two arithmetic shadows agree while a task-relevant ordered trace distinction is lost.",
            "A local arithmetic witness is used to declare universality, real-world truth, trust, or the M6 semantic filler established."
          ]
        }
      ]
    }
  },
