  "euler_logarithmic_cut_candidate": {
    "status": "modern_structural_candidate_with_historical_boundary",
    "open_path_integral": "Integral_gamma dz/z = Log(z_end) - Log(z_start) after choosing and retaining one logarithm branch along gamma",
    "upper_semicircle": {
      "path": "gamma(t) = exp(i t), 0 <= t <= pi",
      "additive_trace": "Integral_gamma dz/z = i pi",
      "multiplicative_readout": "exp(Integral_gamma dz/z) = -1",
      "euler_readout": "exp(i pi) + 1 = 0"
    },
    "closed_loop": {
      "path": "gamma(t) = exp(i t), 0 <= t <= 2 pi",
      "additive_trace": "ContourIntegral_gamma dz/z = 2 pi i",
      "topological_readout": "2 pi i times the winding number for a general closed curve avoiding zero",
      "multiplicative_readout": "exp(ContourIntegral_gamma dz/z) = 1"
    },
    "cut_and_merge_reading": "a logarithm branch cut records the additive jump by an integral period; exponentiation merges sheets differing by 2 pi i without erasing the retained winding trace",
    "historical_lineage": [
      "Johann Bernoulli's early integral work related circular inverse functions to logarithmic expressions",
      "Roger Cotes's 1714 Logometria contained a geometric logarithmic relation interpretable as a precursor of Euler's formula",
      "de Moivre's power formula organized multiplication on the circle",
      "Euler's 1748 Introductio chapter 8 section 138 derived imaginary exponentials in terms of sine and cosine from infinitesimal and exponential formulas",
      "the contour integral and winding-number formulation is a later complex-analysis reconstruction, not Euler's recorded 1748 route"
    ],
    "relation_to_continuity_hypothesis": "the integral measures accumulated transport and the topological obstruction at a hole; it does not create force. A separate capacity and cost witness is still required before writing merge_capacity > rupture_load.",
    "sources": [
