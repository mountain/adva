  "input": {
    "subject": {
      "reading": "a finite observer carrying revisable names, hypotheses, programs, and prior witnesses",
      "initial_holes": [
        "the observer does not know whether the long run converges",
        "the observer cannot certify the final adequacy of the present vocabulary",
        "the observer may itself be refuted by a later transferable witness"
      ]
    },
    "method": {
      "reading": "truth-directed continuation by replayable finite rounds",
      "round_cycle": [
        "open the reality-facing interface",
        "seal the declared inputs, method, resources, and names for one run",
        "run the bounded mechanism without silent external intervention",
        "retain result, counterevidence, cuts, questions, and residual holes",
        "reopen the interface for the next witnessed continuation"
      ],
      "non_immunity_rule": "no author, name, checker, or hypothesis is protected from replayable counterevidence"
    },
    "object": {
      "reading": "the sealed interface record and finite resources supplied to the current round",
      "anchors": [
        {
          "kind": "first_reveal_witness",
